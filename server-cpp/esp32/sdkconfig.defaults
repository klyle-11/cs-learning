CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Long file names on the card and on the state partition
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_WL_SECTOR_SIZE_4096=y
# Open files share one sector buffer per drive instead of holding one each.
# With 4 KB sectors (above) that is 4 KB saved for every file slot and every
# file being sent; files are mostly read in 4 KB pieces straight past it anyway.
CONFIG_FATFS_PER_FILE_CACHE=n
# TLS: the board has no spare memory, so the outgoing buffer is small and
# buffers are only held while in use. About 4 connections fit.
CONFIG_MBEDTLS_TLS_SERVER=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_THREADING_C=y
CONFIG_MBEDTLS_THREADING_PTHREAD=y
# ESP-IDF turns the "alternate" threading on by default; mbedTLS takes one or the other
# CONFIG_MBEDTLS_THREADING_ALT is not set
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
# The listening socket, 4 connections being served, up to 6 open pages kept
# listening for changes, and the clock, name and update lookups.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Updates: a new firmware that crashes or cannot serve before it is kept
# (update.cpp, update_keep) is undone by the bootloader at the next start.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# Root certificates for the HTTPS connection to GitHub: the common set (most
# of the web), smaller than the full one. The release signature is what decides.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# The server listens on IPv4 only (http.hpp); leaving IPv6 out of the network stack
# keeps the program small enough to leave room in its update slot.
CONFIG_LWIP_IPV6=n

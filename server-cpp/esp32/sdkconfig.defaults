# For the LilyGO T3-S3 V1.3 (ESP32-S3) only.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Long file names on the card and on the state partition
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_WL_SECTOR_SIZE_4096=y
# Open files share one sector buffer per drive instead of holding one each.
# With 4 KB sectors (above) that is 4 KB saved for every file slot and every
# file being sent; files are mostly read in 4 KB pieces straight past it anyway.
CONFIG_FATFS_PER_FILE_CACHE=n
# TLS: the board has no spare memory, so the outgoing buffer is small and
# buffers are only held while in use. About 4 connections fit.
CONFIG_MBEDTLS_TLS_SERVER=y
CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_THREADING_C=y
CONFIG_MBEDTLS_THREADING_PTHREAD=y
# ESP-IDF turns the "alternate" threading on by default; mbedTLS takes one or the other
# CONFIG_MBEDTLS_THREADING_ALT is not set
CONFIG_MBEDTLS_HARDWARE_AES=y
CONFIG_MBEDTLS_HARDWARE_SHA=y
CONFIG_MBEDTLS_HARDWARE_MPI=y
# The listening socket, at most 4 connections being served, and the clock and
# mDNS lookups. Store-mode pages poll; no page holds a live-reload socket open.
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Card updates: a new firmware that crashes or cannot serve before it is kept
# (update.cpp, update_keep) is undone by the bootloader at the next start.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
# The server listens on IPv4 only (http.hpp); leaving IPv6 out of the network stack
# keeps the program small enough to leave room in its update slot.
CONFIG_LWIP_IPV6=n

# The LilyGO T3-S3 V1.3: its ESP32-S3FH4R2 carries 2 MB of quad-SPI PSRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
# Ordinary allocations may land in PSRAM (above 16 KB by default; smaller ones,
# and anything for DMA, stay in internal memory)
CONFIG_SPIRAM_USE_MALLOC=y
# TLS keeps its buffers (16 KB in and 4 KB out per connection) and its
# certificates in PSRAM: internal memory is then mostly thread stacks, which is
# what lets the "esp32-psram" profile serve 8 connections and 12 open pages.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Logs and the serial monitor on the USB-C port, which is the chip's own USB
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

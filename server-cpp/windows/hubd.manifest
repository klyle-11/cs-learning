<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Makes Windows give this program file names and text as UTF-8 (Windows 10 version 1903 and later),
     which is what the server's code assumes everywhere. Without it, file names outside ASCII would be garbled. -->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="hub.hubd" version="1.0.0.0"/>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
